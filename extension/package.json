{
  "name": "agent-hub-vscode",
  "displayName": "Agent Hub VS Code Extension",
  "description": "VS Code extension for agent-hub providing sidebar UI for controlling agent runs",
  "version": "1.0.0",
  "publisher": "agent-hub",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ikrar06/agent-hub.git",
    "directory": "extension"
  },
  "bugs": {
    "url": "https://github.com/Ikrar06/agent-hub/issues"
  },
  "icon": "images/agent-icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:agent-hub-panel",
    "onCommand:agent-hub.openPanel"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agent-hub-sidebar",
          "title": "Agent Hub",
          "icon": "images/agent-icon.svg"
        }
      ]
    },
    "views": {
      "agent-hub-sidebar": [
        {
          "id": "agent-hub-panel",
          "name": "Agent Hub Panel"
        }
      ]
    },
    "commands": [
      {
        "command": "agent-hub.openPanel",
        "title": "Agent Hub: Open Panel"
      }
    ],
    "configuration": {
      "title": "Agent Hub",
      "properties": {
        "agentHub.monitorUrl": {
          "type": "string",
          "default": "http://127.0.0.1:3777",
          "description": "URL of the agent-hub monitor web server."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "node ./test/runTest.js",
    "package": "npx --yes @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/glob": "^8.0.1",
    "@types/mocha": "^10.0.1",
    "@types/node": "20.x",
    "eslint": "^8.41.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^5.1.3",
    "vscode-test": "^1.5.0"
  }
}
